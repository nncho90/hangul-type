{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "hangul-type.vercel.app" }],
      "destination": "https://typehangeul.com/",
      "permanent": true
    },
    {
      "source": "/:path+",
      "has": [{ "type": "host", "value": "hangul-type.vercel.app" }],
      "destination": "https://typehangeul.com/:path+",
      "permanent": true
    }
  ]
}
